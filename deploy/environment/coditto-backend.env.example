# Copy this file to /etc/coditto/backend.env on the deployment host.
# Keep the real file readable only by root and the coditto service account.

# These must be absolute paths on the deployment host. The backend process must
# be able to read every path, and Docker must be able to read the temporary
# candidate directories created below.
CODITTO_PROBLEMS_ROOT_PATH=/srv/coditto/current/problems
CODITTO_RUNNER_PYTHON_COMMAND=/usr/bin/python3
CODITTO_RUNNER_SCRIPT_PATH=/srv/coditto/current/judge-runner/run.py
CODITTO_RUNNER_TIMEOUT=75s

# Optional: omit this line to keep interview-question generation unavailable.
# OPENAI_API_KEY=replace-with-a-real-key
